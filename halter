local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local References = require(ReplicatedStorage:WaitForChild("References"))
local Utilities = References.Utilities
local CraftingHandler = require(References.PlayerScripts.Secondary:WaitForChild("CraftingHandler"))

-- Find halter ID
local halterId = nil
for id, entry in pairs(References.Items.byId) do
    local info = References.Items.GetInfo(id)
    if info and info.name and info.name:lower():find("halter") then
        halterId = id
        break
    end
end

if not halterId then
    warn("[AutoCraft] Could not find halter item.")
    return
end

