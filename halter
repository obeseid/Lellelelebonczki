------------------------------------------------------------------------
-- Loop logic
------------------------------------------------------------------------
local running = false
local craftCount = 0
local loopThread = nil

local function setRunning(state)
    running = state
    if running then
        btn.Text = "Stop"
        btn.BackgroundColor3 = Color3.fromRGB(220, 80, 80)
        statusLabel.Text = "Status: Running"
        statusLabel.TextColor3 = Color3.fromRGB(120, 230, 140)
    else
        btn.Text = "Start"
        btn.BackgroundColor3 = Color3.fromRGB(90, 200, 120)
        statusLabel.Text = "Status: Idle"
        statusLabel.TextColor3 = Color3.fromRGB(160, 160, 180)
    end
end

local function startLoop()
    loopThread = task.spawn(function()
        while running do
            local itemData = {
                id = halterId,
                amt = 1,
                variants = { Prismatic = true },
            }

            local ok, reason = CraftingHandler.CanCraft(itemData)

            if ok then
                if Utilities.Cooldown.Check("craftItem", References.Constants.CRAFT_COOLDOWN, true) then
                    Utilities.Network:FireServer("Crafting", "Craft", itemData)
                    craftCount += 1
                    countLabel.Text = ("Crafted: %d"):format(craftCount)
                end
            else
                warn(("[AutoCraft] Stopped: %s"):format(reason or "unknown"))
                statusLabel.Text = ("Stopped: %s"):format(reason or "unknown")
                statusLabel.TextColor3 = Color3.fromRGB(230, 100, 100)
                setRunning(false)
                break
            end

            task.wait(1)
        end
    end)
end

btn.Activated:Connect(function()
    if running then
        running = false
        setRunning(false)
        if loopThread then
            task.cancel(loopThread)
            loopThread = nil
        end
    else
        setRunning(true)
        startLoop()
    end
end)
